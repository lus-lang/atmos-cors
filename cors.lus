--- Adds Cross-Origin Resource Sharing to `web` applications.
---
--- The plugin adds a route for `OPTIONS /*` under the prefix of the scope
--- that registers it, which answers preflight requests. It also adds the
--- `Access-Control-*` headers to every response of that scope. A request
--- from an origin that the options do not allow gets no CORS headers, so the
--- browser blocks the response.
---
--- The following application accepts cross-origin requests from
--- `https://lus.dev` only.
---
--- ```lus nocheck
--- local web = require("https://atmosp.here/2.0/web.lus")
--- local cors = require("https://atmosp.here/2.0/cors.lus")
---
--- local app = web.app()
--- app:register(cors, { origin = { "https://lus.dev" } })
--- ```
---
--- @package cors
--- @version 1.0.0
--- @lus 2.0
--- @license 0BSD
--- @repository https://github.com/lus-lang/atmos-cors

local M = {}

local function join(value, default)
    if value == nil then
        return default
    end

    if type(value) == "table" then
        return table.concat(value, ", ")
    end

    return value
end

-- Returns a function from the request origin to the value of
-- Access-Control-Allow-Origin, or nil when the origin is not allowed.
local function origin_matcher(origin)
    if origin == nil or origin == "*" then
        return function()
            return "*"
        end, false
    end

    if origin == true then
        return function(o)
            return o
        end, true
    end

    if type(origin) == "function" then
        return function(o, req)
            local result = origin(o, req)

            if result == true then
                return o
            end

            return result or nil
        end, true
    end

    if type(origin) == "string" then
        if origin:find("[%%%[%]%^%$%*%+%-%?%(%)%.]") and origin:sub(1, 1) == "^" then
            return function(o)
                return o?:find(origin) and o or nil
            end, true
        end

        return function(o)
            return o == origin and o or nil
        end, true
    end

    local set = {}

    for _, o in ipairs(origin) do
        set[o] = true
    end

    return function(o)
        return o and set[o] and o or nil
    end, true
end

--- Registers the CORS plugin on a `web` scope.
---
--- The options are the following.
---
--- - `origin`: `"*"` (the default), one origin, a list of origins, a Lus
---   pattern that starts with `^`, `true` to reflect any origin, or a
---   function `origin(value, req)` that returns `true`, an origin, or a falsy
---   value.
--- - `methods`: the allowed methods, by default `GET, HEAD, PUT, PATCH, POST, DELETE`.
--- - `headers`: the allowed request headers. By default the plugin reflects
---   the `Access-Control-Request-Headers` of the preflight.
--- - `expose`: the response headers that scripts may read.
--- - `credentials`: `true` to send `Access-Control-Allow-Credentials`.
--- - `max_age`: how many seconds a browser may cache a preflight.
---
--- `credentials = true` with the origin `"*"` raises an error, because
--- browsers reject that combination.
--- @param scope table The `web` scope.
--- @param options table? The options.
function M.register(scope, options)
    options = options or {}
    local match, varies = origin_matcher(options.origin)

    if options.credentials and not varies then
        error("cors: credentials need an explicit origin, not '*'", 2)
    end

    local methods = join(options.methods, "GET, HEAD, PUT, PATCH, POST, DELETE")
    local allowed_headers = join(options.headers, nil)
    local expose = join(options.expose, nil)
    local credentials = options.credentials and "true" or nil
    local max_age = options.max_age and tostring(math.floor(options.max_age)) or nil

    local function preflight(req)
        local headers = {}
        local allow = match(req.headers.origin, req)

        if allow and req.headers["access-control-request-method"] then
            headers["Access-Control-Allow-Origin"] = allow
            headers["Access-Control-Allow-Methods"] = methods
            headers["Access-Control-Allow-Headers"] = allowed_headers
                or req.headers["access-control-request-headers"]
            headers["Access-Control-Allow-Credentials"] = credentials
            headers["Access-Control-Max-Age"] = max_age
        end

        if varies then
            headers.Vary = allowed_headers and "Origin" or "Origin, Access-Control-Request-Headers"
        end

        return 204, "", headers
    end

    scope:options("/*", preflight)

    scope:hook("on_send", function(req, status, body, headers)
        local origin = req.headers.origin

        if origin == nil and varies == false then
            return status, body, headers
        end

        local allow = match(origin, req)

        if allow == nil and not varies then
            return status, body, headers
        end

        local out = headers and table.clone(headers) or {}

        if allow then
            out["Access-Control-Allow-Origin"] = allow
            out["Access-Control-Allow-Credentials"] = credentials
            out["Access-Control-Expose-Headers"] = expose
        end

        if varies then
            out.Vary = out.Vary and `$(out.Vary), Origin` or "Origin"
        end

        return status, body, out
    end)
end

--- `true`, so `scope:register(cors)` applies the plugin to every route of
--- `scope`.
M.shared = true

return M
